# Base URL of the backend API (without trailing slash or /api).
# Leave empty to use same-origin requests — this is the default and what the
# Vercel deploy uses, since vercel.json rewrites /api/* to the Railway backend.
# Only set this for a setup where the frontend calls the backend cross-origin
# (then also set CORS_ORIGIN on the backend to this frontend's URL).
VITE_API_URL=
