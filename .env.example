# App-specific vars use a _TP suffix (this Vercel account hosts several apps).
# Platform standards (NODE_ENV, PORT, HOST) keep their conventional names.
#
# Local dev: copy to .env at the repo root. With no TURSO_* vars the backend
# uses a local SQLite file (trip-planner.db). Auth still needs the
# GOOGLE_CLIENT_ID_TP / ALLOWED_EMAILS_TP / JWT_SECRET_TP values below.

NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL_TP=debug

# CORS only matters when the frontend calls the API cross-origin.
# On Vercel the frontend and API share an origin, so this is unused there.
CORS_ORIGIN_TP=http://localhost:5173

# ── Auth (Épica 7) ───────────────────────────────────────────────
# Google OAuth 2.0 Client ID (Web application) from console.cloud.google.com.
# Authorized JavaScript origins must include http://localhost:5173 and the
# Vercel domain. The frontend needs the same value as VITE_GOOGLE_CLIENT_ID_TP
# (see frontend/.env.example) — on Vercel set both.
GOOGLE_CLIENT_ID_TP=xxxxx.apps.googleusercontent.com

# Comma-separated list of Google emails allowed to use the app.
# Empty/unset = nobody gets in (fail closed).
ALLOWED_EMAILS_TP=you@gmail.com

# Secret for signing session tokens. REQUIRED in production (the app refuses
# to authenticate without a real one). Generate: openssl rand -hex 32
JWT_SECRET_TP=
JWT_EXPIRES_IN_TP=7d

# ── Turso (production / Vercel) ───────────────────────────────────
# Set these to point the backend at Turso instead of a local file.
#   turso db show <db> --url          -> TURSO_DATABASE_URL_TP
#   turso db tokens create <db>       -> TURSO_AUTH_TOKEN_TP
# On Vercel, add them as Environment Variables (do not commit real values).
# TURSO_DATABASE_URL_TP=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN_TP=

# Optional: override the local SQLite file path
# DB_PATH_TP=./trip-planner.db
