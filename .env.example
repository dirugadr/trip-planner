# ── Local development ─────────────────────────────────────────────
# With no TURSO_* vars set, the backend uses a local SQLite file
# (trip-planner.db in the repo root). This is all you need for `npm run dev`.

NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# CORS only matters when the frontend calls the API cross-origin.
# On Vercel the frontend and API share an origin, so this is unused there.
CORS_ORIGIN=http://localhost:5173

# ── Turso (production / Vercel) ───────────────────────────────────
# Set these to point the backend at Turso instead of a local file.
#   turso db show <db> --url          -> TURSO_DATABASE_URL
#   turso db tokens create <db>       -> TURSO_AUTH_TOKEN
# On Vercel, add them as Environment Variables (do not commit real values).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Unused for now (no auth implemented)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
