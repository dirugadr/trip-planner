# Frontend build-time env (Vite only exposes VITE_* to the client).
# Local dev: copy to frontend/.env. Production: set in the Vercel project.
# App vars use a _TP suffix (shared Vercel account).

# Google OAuth 2.0 Client ID — same value as the backend's GOOGLE_CLIENT_ID_TP.
VITE_GOOGLE_CLIENT_ID_TP=xxxxx.apps.googleusercontent.com

# Optional: backend origin when NOT served same-origin (leave empty on Vercel).
# VITE_API_URL_TP=
